{
  "name": "@xoong/mcp",
  "version": "0.0.51",
  "description": "MCP server for xoong: gives AI assistants the spec (llms.txt) and the docs, the API's operations, `xoong check` and explanations of every error code, element and attribute over stdio.",
  "type": "module",
  "bin": {
    "xoong-mcp": "src/cli.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "license": "MIT",
  "dependencies": {
    "@xoong/cli": "0.0.51"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "prepack": "node prepack.mjs",
    "postpack": "node prepack.mjs --clean"
  },
  "keywords": [
    "xoong",
    "web-framework",
    "openapi",
    "custom-elements"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "author": "Duong Tran Xuan <duongtx1505@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpt-duongtx/xoong.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/fpt-duongtx/xoong/issues"
  },
  "homepage": "https://fpt-duongtx.github.io/xoong/",
  "publishConfig": {
    "access": "public"
  }
}
