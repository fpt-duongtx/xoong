{
  "name": "xoong",
  "version": "0.0.30",
  "description": "xoong: a small, standards-first web framework. One install for the runtime (signals, templates, OpenAPI data layer), the admin set and the `xoong` command.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "xoong": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./view": "./src/view.js",
    "./ui": "./src/ui.js"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "xoong",
    "web-framework",
    "openapi",
    "custom-elements"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "author": "Duong Tran Xuan <duongtx1505@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpt-duongtx/xoong.git",
    "directory": "packages/xoong"
  },
  "bugs": {
    "url": "https://github.com/fpt-duongtx/xoong/issues"
  },
  "homepage": "https://github.com/fpt-duongtx/xoong#readme",
  "dependencies": {
    "@xoong/cli": "0.0.30",
    "@xoong/core": "0.0.30",
    "@xoong/data": "0.0.30",
    "@xoong/forms": "0.0.30",
    "@xoong/ui": "0.0.30"
  },
  "publishConfig": {
    "access": "public"
  }
}
