{
  "name": "@xoong/ui",
  "version": "0.0.51",
  "description": "xoong admin set: xoong.css tokens, <xo-table>, <xo-form>, <xo-dialog>, toast, confirm and a declarative History-API router. Depends on @xoong/core, @xoong/data and @xoong/forms.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./table": "./src/table.js",
    "./pager": "./src/pager.js",
    "./form": "./src/form.js",
    "./dialog": "./src/dialog.js",
    "./toast": "./src/toast.js",
    "./router": "./src/router.js",
    "./xoong.css": "./src/xoong.css",
    "./mist.css": "./src/mist.css"
  },
  "sideEffects": true,
  "license": "MIT",
  "dependencies": {
    "@xoong/core": "0.0.51",
    "@xoong/data": "0.0.51",
    "@xoong/forms": "0.0.51"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "xoong",
    "web-framework",
    "openapi",
    "custom-elements"
  ],
  "author": "Duong Tran Xuan <duongtx1505@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpt-duongtx/xoong.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/fpt-duongtx/xoong/issues"
  },
  "homepage": "https://fpt-duongtx.github.io/xoong/",
  "types": "./src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  }
}
