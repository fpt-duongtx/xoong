{
  "name": "@xoong/ui",
  "version": "0.0.15",
  "description": "xoong admin set: xoong.css design tokens, <xo-table>, <xo-form>, <xo-dialog>. Depends only on @xoong/core and @xoong/data.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./table": "./src/table.js",
    "./form": "./src/form.js",
    "./dialog": "./src/dialog.js",
    "./toast": "./src/toast.js",
    "./router": "./src/router.js",
    "./xoong.css": "./src/xoong.css"
  },
  "sideEffects": true,
  "license": "MIT",
  "dependencies": {
    "@xoong/core": "*",
    "@xoong/data": "*",
    "@xoong/forms": "*"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "xoong",
    "web-framework",
    "openapi",
    "custom-elements"
  ],
  "author": "Duong Tran Xuan <duongtx1505@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpt-duongtx/xoong.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/fpt-duongtx/xoong/issues"
  },
  "homepage": "https://github.com/fpt-duongtx/xoong#readme",
  "types": "./src/index.d.ts"
}
