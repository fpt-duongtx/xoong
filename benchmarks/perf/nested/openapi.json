{
  "openapi": "3.0.3",
  "info": { "title": "Accounts with orders and line items (perf workload)", "version": "1.0.0" },
  "paths": {
    "/accounts": { "get": { "operationId": "listAccounts", "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer" } }],
      "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountPage" } } } } } } },
    "/items/{id}/bump": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "post": { "operationId": "bumpItem", "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } } } } }
  },
  "components": { "schemas": {
    "AccountPage": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } } } },
    "Account": { "type": "object", "required": ["id", "name", "orders"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "orders": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } },
    "Order": { "type": "object", "required": ["id", "status", "items"], "properties": { "id": { "type": "integer" }, "status": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } } } },
    "Item": { "type": "object", "required": ["id", "sku", "qty"], "properties": { "id": { "type": "integer" }, "sku": { "type": "string" }, "qty": { "type": "integer" } } }
  } }
}
