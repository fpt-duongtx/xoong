{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": []
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"]
}
