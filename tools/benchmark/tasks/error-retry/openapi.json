{
  "openapi": "3.0.3",
  "info": {
    "title": "Notes (example)",
    "version": "1.0.0"
  },
  "paths": {
    "/notes": {
      "get": {
        "operationId": "listNotes",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Note"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Note": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "error",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
