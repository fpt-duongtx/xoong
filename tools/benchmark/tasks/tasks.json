{
  "small-site": {
    "spec": "small-site/openapi.json",
    "files": [
      "index.html",
      "post.html"
    ],
    "mustUse": [
      "listPosts",
      "getPost"
    ],
    "mustContain": [
      "xo-each",
      "p-id|params",
      "href="
    ]
  },
  "crud-admin": {
    "spec": "crud-admin/openapi.json",
    "files": [
      "index.html"
    ],
    "mustUse": [
      "listUsers",
      "createUser",
      "disableUser",
      "deleteUser"
    ],
    "mustContain": [
      "xo-each|xo-table",
      "xo-submit|xo-form",
      "xo-click"
    ]
  },
  "shared-data": {
    "spec": "shared-data/openapi.json",
    "hints": "shop-hints.json",
    "files": [
      "index.html"
    ],
    "mustUse": [
      "listOrders",
      "listCustomers"
    ],
    "mustContain": [
      "xo-each|xo-table",
      "customer.name"
    ]
  },
  "live-updates": {
    "spec": "live-updates/openapi.json",
    "files": [
      "index.html"
    ],
    "mustUse": [
      "listUsers",
      "disableUser"
    ],
    "mustContain": [
      "live",
      "xo-each|xo-table",
      "xo-click"
    ]
  },
  "admin-table": {
    "spec": "admin-table/openapi.json",
    "files": [
      "index.html"
    ],
    "mustUse": [
      "listStaff",
      "createStaff"
    ],
    "mustContain": [
      "xo-table",
      "xo-form|xo-submit",
      "xo-dialog"
    ]
  },
  "paging-filter": {
    "spec": "paging-filter/openapi.json",
    "files": [
      "index.html"
    ],
    "mustUse": [
      "listArticles"
    ],
    "mustContain": [
      "xo-each",
      "xo-param",
      "$hasNext|offset"
    ]
  }
}
